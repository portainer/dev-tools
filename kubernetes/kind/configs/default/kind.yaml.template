kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
nodes:
- role: control-plane
  extraPortMappings:
  - containerPort: 9000
    # hostPort will be the port to use to access portainer instance at localhost:hostPort
    hostPort: 9000
  - containerPort: 8000
    hostPort: 8000
  - containerPort: 30777
    hostPort: 30777
# uncomment to following line to have a 2 nodes cluster (1 master + 1 worker)
# - role: worker
# - role: worker
